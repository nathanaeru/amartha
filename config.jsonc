{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "windows",
    "padding": {
      "top": 3,
      "left": 1,
    },
  },
  "display": { "separator": " " },
  "modules": [
    { "key": "╭─────────────╮", "type": "custom" },
    { "key": "│  user      │", "type": "title", "format": "{user-name}" },
    { "key": "│ 󰇅 hname     │", "type": "title", "format": "{host-name}" },
    { "key": "│ 󰅐 uptime    │", "type": "uptime" },
    { "key": "│  distro    │", "type": "os" },
    { "key": "│  kernel    │", "type": "kernel" },
    { "key": "│  wm        │", "type": "wm" },
    { "key": "│  term      │", "type": "terminal" },
    { "key": "│  shell     │", "type": "shell" },
    { "key": "│ 󰍛 cpu       │", "type": "cpu", "showPeCoreCount": true },
    { "key": "│  disk (C:) │", "type": "disk", "folders": "C:\\" },
    { "key": "│  disk (D:) │", "type": "disk", "folders": "D:\\" },
    { "key": "│  disk (E:) │", "type": "disk", "folders": "E:\\" },
    { "key": "│  memory    │", "type": "memory" },
    { "key": "├─────────────┤", "type": "custom" },
    { "key": "│ PC          │", "type": "host" },
    { "key": "│ ├ 󰢮 gpu     │", "type": "gpu" },
    { "key": "│ ├ 󰓡 swap    │", "type": "swap" },
    {
      "key": "│ ├  disp    │",
      "type": "monitor",
    },
    { "key": "│ ├ 󰁹 batt    │", "type": "battery" },
    {
      "key": "│ └  dtime   │",
      "type": "command",
      "shell": "powershell",
      "text": "$days = (New-TimeSpan -Start (Get-CimInstance Win32_OperatingSystem).InstallDate).Days; Write-Output \"$days days\"",
    },
    { "key": "╰─────────────╯", "type": "custom" },
    /* {
      "key": " ",
      "type": "custom",
      "format": "{#30} {#31} {#32} {#33} {#34} {#35} {#36} {#37} ",
    }, */
  ],
}
